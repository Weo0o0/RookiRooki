# Temporary TEST rules for backend tests and local pcap checks only.
# The real rule file is rules/custom.rules (owned by the rule role).
alert http any any -> any any (msg:"TEST sqli in URI"; flow:established,to_server; http.uri; content:"' OR '"; nocase; classtype:web-application-attack; sid:1000001; rev:1;)
alert http any any -> any any (msg:"TEST xss in URI"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1000002; rev:1;)
alert tcp any any -> any 22 (msg:"TEST ssh bruteforce"; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-user; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"TEST portscan"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)
